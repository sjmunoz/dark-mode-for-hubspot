{
  "manifest_version": 3,
  "name": "Dark Mode for HubSpot",
  "version": "1.0.0",
  "description": "Makes HubSpot dark. Click the icon or press Alt+Shift+D to turn it on or off. Not made by HubSpot.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Dark Mode for HubSpot (Alt+Shift+D)",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Turn HubSpot dark mode on or off"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.hubspot.com/*",
        "https://app-eu1.hubspot.com/*",
        "https://app-na2.hubspot.com/*",
        "https://app-na3.hubspot.com/*",
        "https://app-ap1.hubspot.com/*"
      ],
      "css": [
        "dark.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "homepage_url": "https://github.com/sjmunoz/dark-mode-for-hubspot"
}
